# Which embedding backend to use: huggingface | openai | gemini | ollama
#
# `huggingface` runs locally and needs no key — it is what the Node original
# used — but needs Python <= 3.13 and `pip install fastembed` (see README).
# The bundled .venv has both, so this is set to it. On Python 3.14, switch to
# `openai`: it needs nothing installed and reuses the key below.
EMBEDDING_PROVIDER=huggingface

# OpenAI API key — https://platform.openai.com/api-keys
# Always required: the chat completion still runs on OpenAI.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini — https://aistudio.google.com/apikey (only for EMBEDDING_PROVIDER=gemini)
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Hugging Face runs locally, no key needed. Needs `pip install fastembed`
# (ONNX, light) or `pip install sentence-transformers` (Torch, heavier), and
# Python <= 3.13 for either.
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama runs locally: ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Port the server listens on
PORT=4000

# --- Vector database -------------------------------------------------------
# Postgres + pgvector, started with: docker compose up -d --wait
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatbot
# Table holding the chunks. One table per embedding model.
# PG_TABLE=chunks

# Document indexed at startup, and used by POST /pdf-loader
# PDF_PATH=./WPS 365.pdf

# How many chunks to retrieve per question
# TOP_K=3

# --- Adaptive retrieval ------------------------------------------------------
# Classify each question, then route it: skip retrieval for chit-chat, pick the
# search, and size topK to what was asked. Set to false for the fixed pipeline.
# ADAPTIVE_RAG=true

# Model used to classify questions and to rephrase them. Short calls on short
# prompts — the smallest model you have is the right one. Defaults to CHAT_MODEL.
# ROUTER_MODEL=gpt-3.5-turbo

# Bounds on the per-question topK, whatever the routing works out to
# ADAPTIVE_MIN_TOP_K=2
# ADAPTIVE_MAX_TOP_K=10

# Drop chunks scoring below this fraction of the best match (0-1), and below
# this absolute similarity. Set MIN_SCORE to 0 to keep whatever search returns.
# ADAPTIVE_SCORE_RATIO=0.6
# ADAPTIVE_MIN_SCORE=0.2

# Rephrasings a complex question is searched with, the original included
# ADAPTIVE_QUERY_VARIANTS=3

# Classifications remembered, so a repeated question is not re-classified
# CLASSIFY_CACHE=500

# --- Corrective retrieval ----------------------------------------------------
# Grade what was retrieved before using it, and when it does not answer the
# question, rewrite the query and search again. Set to false to use whatever
# the pipeline returns, ungraded.
# CORRECTIVE_RAG=true

# Models for grading chunks, rewriting a failed query, and judging an answer.
# All short calls on short prompts; all default to ROUTER_MODEL.
# GRADE_MODEL=gpt-3.5-turbo
# REWRITE_MODEL=gpt-3.5-turbo
# JUDGE_MODEL=gpt-3.5-turbo

# How much of each chunk the grader is shown, in characters
# GRADE_SNIPPET=400
# Whether on-topic chunks that do not contain the answer count as context.
# false is strict: only passages that answer the question are sent.
# GRADE_KEEP_PARTIAL=true
# Gradings remembered, so a repeated question is not re-graded
# GRADE_CACHE=300

# Correction rounds allowed, at one rewrite call plus one search each
# CRAG_MAX_CORRECTIONS=1
# The searches a correction round falls back to, in order
# CRAG_FALLBACK_STRATEGIES=hybrid,multi_query
# Chunks a fallback search asks for, and the cap on what reaches the prompt
# CRAG_FALLBACK_TOP_K=6
# CRAG_MAX_CHUNKS=8

# --- Answer quality ----------------------------------------------------------
# Retrieval quality is measured for free on every request. This is the other
# half: whether the answer actually used the context. It is one extra LLM call,
# so it is off unless a request sends "evaluate": true — or this says always.
# ANSWER_QUALITY=false

# Below this share of its content words appearing in the context, an answer is
# saying things the context did not
# ANSWER_SUPPORT_MIN=0.35

# --- Conversation -----------------------------------------------------------
# Model used to answer, and to rewrite follow-up questions
# CHAT_MODEL=gpt-3.5-turbo

# Question/answer pairs carried into the next prompt
# HISTORY_TURNS=5
# Pairs shown to the follow-up question rewriter
# CONDENSE_TURNS=2

# A session is forgotten after this long without a message
# SESSION_TTL_MINUTES=60
# Least recently used sessions are evicted past this many
# MAX_SESSIONS=1000
